// 1. Definição das variáveis de estado do jogo/simulador
let lucro = 1000; // Pontos ou R$ iniciais
let impactoAmbiental = 50; // Começa em equilíbrio (0 a 100)

// 2. Captura dos elementos da tela (HTML)
const btnSustentavel = document.getElementById("btn-sustentavel");
const btnConvencional = document.getElementById("btn-convencional");
const statusLucro = document.getElementById("status-lucro");
const statusAmbiente = document.getElementById("status-ambiente");
const mensagemResultado = document.getElementById("mensagem-resultado");

// 3. Função para atualizar os dados na tela
function atualizarTela() {
    statusLucro.innerText = `R$ ${lucro}`;
    statusAmbiente.innerText = `${impactoAmbiental}%`;

    // Muda a cor do texto do impacto ambiental dependendo da gravidade
    if (impactoAmbiental < 40) {
        statusAmbiente.style.color = "#dc3545"; // Vermelho (Alerta)
    } else if (impactoAmbiental > 70) {
        statusAmbiente.style.color = "#28a745"; // Verde (Excelente)
    } else {
        statusAmbiente.style.color = "#ffc107"; // Amarelo (Moderado)
    }

    // Verifica se o jogador ganhou ou perdeu
    checarFimDeJogo();
}

// 4. Lógica das Escolhas do Usuário
function escolherManejo(tipo) {
    if (tipo === "sustentavel") {
        lucro += 200;              // Dá um lucro moderado e constante
        impactoAmbiental += 15;    // Melhora a saúde do ambiente
        mensagemResultado.innerText = "Boa escolha! A rotação de culturas e o uso de bioinsumos protegeram o solo e garantiram uma boa colheita.";
    } else if (tipo === "convencional") {
        lucro += 500;              // Dá muito lucro imediato
        impactoAmbiental -= 25;    // Prejudica gravemente o meio ambiente
        mensagemResultado.innerText = "O lucro foi alto agora, mas o uso excessivo de químicos desgastou o solo e poluiu as fontes de água próximas.";
    }

    // Limita o impacto ambiental entre 0% e 100%
    impactoAmbiental = Math.max(0, Math.min(100, impactoAmbiental));

    atualizarTela();
}

// 5. Função que analisa o equilíbrio (Regra de Negócio do Tema do Agrinho)
function checarFimDeJogo() {
    if (impactoAmbiental <= 0) {
        mensagemResultado.innerHTML = "<strong>Fim de Jogo!</strong> O solo ficou infértil e a água acabou. Sem preservação, a produção quebrou.";
        desativarBotoes();
    } else if (lucro >= 2500 && impactoAmbiental >= 60) {
        mensagemResultado.innerHTML = "<strong>Parabéns!</strong> Você atingiu o <em>Equilíbrio Perfeito</em>. Sua fazenda é forte, altamente produtiva e sustentável!";
        desativarBotoes();
    }