<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador de Fazenda Sustentável - Agrinho 2026</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Simulador de Fazenda Sustentável</h1>
            <p class="subtitle">Equilíbrio entre Produção e Meio Ambiente</p>
        </header>

        <section class="status-panel">
            <div class="status-card">
                <h3>Dinheiro em Caixa</h3>
                <p id="money-display">R$ 10.000</p>
            </div>
            <div class="status-card">
                <h3>Saúde Ambiental</h3>
                <div class="progress-bar">
                    <div id="environment-bar" style="width: 50%;"></div>
                </div>
                <p id="environment-display">50%</p>
            </div>
        </section>

        <main class="game-box">
            <div id="event-card">
                <h2 id="event-title">Início da Temporada</h2>
                <p id="event-description">Escolha uma ação abaixo para começar a gerenciar sua fazenda com equilíbrio.</p>
            </div>

            <div class="actions-container">
                <button class="btn" onclick="makeChoice('agrodefensivo')">Usar Defensivos Químicos Pesados</button>
                <button class="btn" onclick="makeChoice('bioinsumo')">Investir em Bioinsumos Naturais</button>
                <button class="btn" onclick="makeChoice('desmatar')">Expandir Área Desmatando Floresta</button>
                <button class="btn" onclick="makeChoice('plantiodireto')">Adotar Plantio Direto e Rotação</button>
            </div>
        </main>

        <div id="feedback-modal" class="hidden">
            <p id="feedback-text"></p>
            <button class="btn btn-reset" onclick="resetGame()">Reiniciar Simulador</button>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>